# Configuração da API da Loja (T02). Nenhum valor real aqui.
APP_ENV=development
APP_DEBUG=false
APP_HOST=127.0.0.1
PORT=5000
# Obrigatória em produção; em desenvolvimento, gerada aleatoriamente a cada boot.
SECRET_KEY=
# Origens CORS separadas por vírgula; vazio em produção, "*" em desenvolvimento.
CORS_ORIGINS=
DATABASE_PATH=loja.db
