# Configuração da API da Loja (T02). Copie para .env e preencha.
APP_ENV=development
APP_DEBUG=false
APP_HOST=127.0.0.1
PORT=5000
# Obrigatória em produção; em desenvolvimento um valor aleatório é gerado por boot.
SECRET_KEY=
# Token exigido pelas rotas administrativas (/admin/*). Sem ele, elas recusam tudo.
ADMIN_TOKEN=
DATABASE_PATH=loja.db
# Origens CORS separadas por vírgula. Vazio = "*" em dev, nenhuma em produção.
CORS_ORIGINS=
