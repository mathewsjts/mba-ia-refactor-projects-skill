# Ambiente da aplicação
NODE_ENV=development
# Porta HTTP (default 3000, preserva o comando documentado)
PORT=3000
# Arquivo do SQLite (default :memory:, reinicia limpo a cada boot)
DATABASE_FILE=:memory:
# Token exigido nas rotas administrativas/destrutivas (obrigatório em produção)
ADMIN_TOKEN=
# Chave do gateway de pagamento (obrigatória em produção)
PAYMENT_GATEWAY_KEY=
