# Variáveis de ambiente da task-manager-api (sem valores reais).
# Lidas por config.py (Settings.from_env); os valores abaixo são os defaults.
APP_ENV=development
APP_DEBUG=false
APP_HOST=127.0.0.1
PORT=5000
# Obrigatória em produção. Em desenvolvimento, se vazia, é gerada a cada boot
# (os tokens emitidos pelo /login deixam de valer após reiniciar).
SECRET_KEY=
DATABASE_URI=sqlite:///tasks.db
# Lista separada por vírgula. Vazia: "*" em desenvolvimento, nenhuma origem em produção.
CORS_ORIGINS=
# Validade, em segundos, do token exigido nos DELETE (Authorization: Bearer).
AUTH_TOKEN_MAX_AGE=86400
