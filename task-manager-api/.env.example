# Copie para .env e preencha. Nunca versione o .env.
APP_ENV=development
# Obrigatória em produção; em desenvolvimento, sem valor, uma chave aleatória é gerada a cada boot.
SECRET_KEY=
FLASK_DEBUG=false
HOST=127.0.0.1
PORT=5000
DATABASE_URL=sqlite:///tasks.db
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TOKEN_MAX_AGE_SECONDS=86400
